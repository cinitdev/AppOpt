<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务, 保证悬浮球在游戏中不被杀 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 模块更新: 读取 Gitee 更新清单并下载 Root 模块 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 11+ 包可见性: 需要读取任意应用的名称/图标并能拉起它们 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 使用情况访问: 用 UsageStatsManager 判断目标游戏是否在前台(替代解析 dumpsys),
         跨品牌/12-16 行为一致。属特殊权限, 需用户在系统设置里手动授予。 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 桌面应用目录按启动 Intent 可见，不依赖完整应用列表查询权限。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".QixiaThreadsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QixiaThreads">

        <activity
            android:name=".QixiaThreadsComposeActivity"
            android:exported="true"
            android:theme="@style/Theme.QixiaThreads.Compose.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HistoryActivity"
            android:exported="false" />

        <activity
            android:name=".UpdateInstallActivity"
            android:exported="false" />

        <service
            android:name=".HistoryCleanupService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <service
            android:name=".PerformanceOverlayService"
            android:process=":overlay"
            android:permission="android.permission.DUMP"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动启用并点击开始的应用性能记录悬浮控件" />
        </service>

        <service
            android:name=".FloatingBallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="性能优化悬浮球与帧率监测" />
        </service>

    </application>
</manifest>
