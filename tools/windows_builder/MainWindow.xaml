<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="柒夏线程 · 构建中心" Width="1180" Height="860" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#172B4D"/>
    <SolidColorBrush x:Key="Muted" Color="#60718B"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9"/><Setter Property="Foreground" Value="#2355A4"/>
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D4DFEF"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Box" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#1673FF"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9,8"/><Setter Property="Background" Value="#F8FAFD"/>
      <Setter Property="BorderBrush" Value="#D4DFEF"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Input" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
          <ScrollViewer x:Name="PART_ContentHost"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="#2563EB"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#F8FAFD"/><Setter Property="BorderBrush" Value="#D4DFEF"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="Input" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="#2563EB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="38"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#F8FAFD" BorderBrush="#D4DFEF" BorderThickness="1" CornerRadius="8"/></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" Margin="12,9,30,9" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <Path IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" Stroke="#60718B" StrokeThickness="1.5" Data="M 0,0 L 4,4 L 8,0"/>
          <Border x:Name="FocusBorder" IsHitTestVisible="False" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" Background="White" BorderBrush="#C6D6EB" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,3,0,0">
              <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="#2563EB"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="9,10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Choice" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="#F0F5FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="#E7EFFF"/><Setter Property="Foreground" Value="#245DC1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal"><Border x:Name="Switch" Width="32" Height="18" Background="#BCC9DA" CornerRadius="9" VerticalAlignment="Center"><Ellipse x:Name="Knob" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="3,0"/></Border><ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="#2563EB"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Switch" Property="BorderBrush" Value="#172B4D"/><Setter TargetName="Switch" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Cursor="Hand">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Header" Background="#F3F6FC" CornerRadius="8" Padding="11,10"><DockPanel><Path x:Name="Arrow" DockPanel.Dock="Right" Stroke="#506B94" StrokeThickness="1.5" Data="M 0,0 L 4,4 L 8,0" VerticalAlignment="Center"/><ContentPresenter/></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Header" Property="Background" Value="#E9F0FC"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Header" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Header" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
          <ContentPresenter Content="{TemplateBinding Header}"/>
        </ToggleButton>
        <ContentPresenter x:Name="Expanded" Visibility="Collapsed" Content="{TemplateBinding Content}"/>
      </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Expanded" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
          <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#A9BAD3" CornerRadius="4" Margin="4,1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
        </Track>
      </Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,18,0,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Note" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="20"/></Style>
  </Window.Resources>
  <Grid Margin="28,22,28,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="48" Height="48" CornerRadius="14" Background="#2563EB" Margin="0,0,14,0">
        <Viewbox Margin="12"><Canvas Width="24" Height="24"><Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 3,6 L 8,11 L 3,16 M 12,17 L 21,17"/></Canvas></Viewbox>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="23" FontWeight="SemiBold" Text="柒夏线程 · 构建中心"/><TextBlock Foreground="{StaticResource Muted}" Margin="1,3,0,0" Text="QIXIA BUILD STUDIO     /     编译 · 打包 · 发布" FontSize="11"/></StackPanel>
      <Border Grid.Column="2" Background="#E5EDFF" CornerRadius="8" Padding="12,8" VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" Text="本地项目" Foreground="#2455A3" FontSize="12"/></Border>
    </Grid>
    <Border Grid.Row="1" Background="White" BorderBrush="#E0E7F1" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="152"/><ColumnDefinition Width="146"/><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="构建版本" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="APK / 模块 / Rust" Style="{StaticResource Note}" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="版本名" FontSize="11" Foreground="#60718B" Margin="0,0,0,5"/><TextBox x:Name="VersionName" AutomationProperties.Name="版本名" ToolTip="例如 v2.0.2"/></StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="版本编号" FontSize="11" Foreground="#60718B" Margin="0,0,0,5"/><TextBox x:Name="VersionCode" AutomationProperties.Name="版本编号" ToolTip="发布新版时递增，例如 202"/></StackPanel>
        <TextBlock x:Name="VersionNote" Grid.Column="3" Style="{StaticResource Note}" FontSize="11" VerticalAlignment="Center" Margin="8,0,16,0" Text="保存或开始构建时，同步 APK、模块、Rust 和更新配置。"/>
        <Button x:Name="SaveVersion" Grid.Column="4" Content="保存版本" VerticalAlignment="Center" Padding="10,9" Background="#2563EB" BorderBrush="#2563EB" Foreground="White" Margin="0,0,10,0"/>
        <Button x:Name="ReloadVersion" Grid.Column="5" Content="重新载入" VerticalAlignment="Center" Padding="10,9"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="348"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="14" BorderBrush="#E0E7F1" BorderThickness="1">
        <DockPanel Margin="20">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
            <Button x:Name="StartButton" Content="开始构建" Background="#2563EB" BorderBrush="#2563EB" Foreground="White" FontWeight="SemiBold" FontSize="14" Padding="15,13"/>
            <Button x:Name="CheckButton" Content="检查构建环境" Margin="0,8,0,0"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Configuration" Margin="0,0,4,0">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="构建配置"/>
              <TextBlock Style="{StaticResource Label}" Text="项目目录"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ProjectPath" AutomationProperties.Name="项目目录" MinWidth="100"/>
                <Button x:Name="BrowseProject" Grid.Column="1" Content="浏览" Margin="6,0,0,0" Padding="10,7"/>
              </Grid>
              <TextBlock Style="{StaticResource Label}" Text="构建类型"/>
              <ComboBox x:Name="Variant" SelectedIndex="0" AutomationProperties.Name="构建类型">
                <ComboBoxItem Content="正式版 · Release APK + 模块"/>
                <ComboBoxItem Content="调试版 · Debug APK + 模块"/>
                <ComboBoxItem Content="仅模块 · 不包含 APK"/>
              </ComboBox>
              <TextBlock Style="{StaticResource Label}" Text="完成后"/>
              <ComboBox x:Name="Action" SelectedIndex="0" AutomationProperties.Name="构建完成后的操作">
                <ComboBoxItem Content="仅生成本地产物"/>
                <ComboBoxItem Content="预演发布 · 不写入远端"/>
                <ComboBoxItem Content="发布版本"/>
              </ComboBox>
              <StackPanel x:Name="PublishOptions" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Label}" Text="发布平台"/>
                <ComboBox x:Name="Target" SelectedIndex="0" AutomationProperties.Name="发布平台"><ComboBoxItem Content="Gitee"/><ComboBoxItem Content="GitHub"/></ComboBox>
                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Text="发布模块 ZIP，并更新 modules-update 分支。发布前请核对版本和更新日志。"/>
              </StackPanel>
              <CheckBox x:Name="UpdateSubmodule" Content="构建前更新 Aya 子模块" IsChecked="True" Margin="0,20,0,0"/>
              <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0" Text="与脚本默认行为一致；取消后使用本地版本。"/>
              <Expander Header="工具路径与凭据" Margin="0,22,0,0" Foreground="#36567E">
                <StackPanel Margin="0,4,0,4">
                  <TextBlock Style="{StaticResource Label}" Text="Git Bash"/>
                  <TextBox x:Name="BashPath" AutomationProperties.Name="Git Bash 路径" ToolTip="Git for Windows 的 bash.exe"/>
                  <TextBlock Style="{StaticResource Label}" Text="JDK 目录（可选）"/>
                  <TextBox x:Name="JavaPath" AutomationProperties.Name="JDK 目录"/>
                  <TextBlock Style="{StaticResource Label}" Text="NDK 目录（可选）"/>
                  <TextBox x:Name="NdkPath" AutomationProperties.Name="NDK 目录"/>
                  <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Text="留空沿用系统环境。SDK 优先读取 local.properties，与脚本一致。"/>
                  <TextBlock Style="{StaticResource Label}" Text="Gitee Token（本次会话）"/>
                  <PasswordBox x:Name="Token" Padding="9,8" BorderBrush="#D4DFEF" AutomationProperties.Name="Gitee Token"/>
                  <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Text="不保存凭据。留空使用 GITEE_TOKEN；GitHub 使用已登录的 gh。"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" CornerRadius="14" BorderBrush="#E0E7F1" BorderThickness="1" Padding="22,18" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="StateLabel" Text="准备就绪" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock x:Name="StageLabel" Text="选择构建类型，开始生成模块与 APK。" Style="{StaticResource Note}" Margin="0,6,14,0"/>
              <ProgressBar x:Name="Progress" Height="3" Margin="0,12,14,0" IsIndeterminate="False" Visibility="Collapsed" Foreground="#2563EB" Background="#EAF0FC"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="Elapsed" Text="00:00" FontFamily="Consolas" FontSize="20" HorizontalAlignment="Center" Foreground="#526888"/>
              <Button x:Name="StopButton" Content="停止" IsEnabled="False" Padding="14,5" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="1" Background="#142237" CornerRadius="14" Padding="18,16">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CopyLog" Content="复制" Padding="10,4" Margin="0,0,6,0" Background="#23374F" BorderBrush="#40556F" Foreground="#D8E8FF"/>
                <Button x:Name="ExportLog" Content="导出" Padding="10,4" Background="#23374F" BorderBrush="#40556F" Foreground="#D8E8FF"/>
              </StackPanel>
              <TextBlock Text="构建输出" Foreground="#E2ECFC" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBox x:Name="Log" Grid.Row="1" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Foreground="#D1DFF2" Background="Transparent" BorderThickness="0" Padding="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="构建日志"/>
            <DockPanel Grid.Row="2" Margin="0,12,0,0">
              <CheckBox x:Name="AutoScroll" Content="自动滚动" IsChecked="True" Foreground="#BCCDE4" DockPanel.Dock="Right" FontSize="11"/>
              <TextBlock Text="UTF-8  /  stdout + stderr" FontFamily="Consolas" FontSize="11" Foreground="#9EB3D0" VerticalAlignment="Center"/>
            </DockPanel>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="White" CornerRadius="14" BorderBrush="#E0E7F1" BorderThickness="1" Padding="18,14" Margin="0,14,0,0">
          <StackPanel>
            <DockPanel><Button x:Name="OpenFolder" DockPanel.Dock="Right" Content="打开目录" Padding="10,5"/><TextBlock Text="构建产物" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
            <TextBlock x:Name="ArtifactNote" Text="生成后可打开 ZIP 和 APK 所在位置。" Style="{StaticResource Note}" Margin="0,6,0,10"/>
            <WrapPanel><Button x:Name="OpenZip" Content="模块 ZIP" IsEnabled="False" Padding="12,6" Margin="0,0,8,0"/><Button x:Name="OpenApk" Content="Android APK" IsEnabled="False" Padding="12,6"/></WrapPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="CommandLabel" Text="使用项目原有 build_module.sh · 本地编译" Foreground="#60718B" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" Margin="2,14,0,0" TextTrimming="CharacterEllipsis"/>
  </Grid>
</Window>
